# --- Supabase ---
# Proyecto de Supabase (Project Settings > API). El anon key es público (va al
# browser), pero solo puede hacer lo que las políticas de Row Level Security
# permiten — nunca uses el service_role key en esta app.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Cifrado de credenciales ARCA ---
# Clave simétrica (32 bytes en base64) usada SOLO en el servidor para cifrar
# el certificado y la clave privada antes de guardarlos en la base de datos.
# Generala una vez con: openssl rand -base64 32
# Si la perdés o la cambiás, todas las configuraciones de ARCA guardadas
# quedan ilegibles y hay que volver a cargar el certificado/clave.
CREDENTIALS_ENCRYPTION_KEY=

# --- Ambiente de ARCA (homologación vs producción) ---
# Esto NO es una variable de entorno: se elige por usuario, dentro de la app,
# en la pantalla de Configuración. Así podés tener la misma instancia
# apuntando a homologación mientras probás y pasar a producción sin
# redeployar nada. El certificado y la clave privada que cargues tienen que
# corresponder al ambiente elegido (son certificados distintos).
